# Sao chép file này thành .env.local rồi điền giá trị thật (Next.js KHÔNG đọc file .env.example).
# Lấy 2 giá trị trong Supabase Dashboard → Project Settings → API Keys
# (hoặc nút "Connect" → App Frameworks → Next.js)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# --- Nhắc ghi chép mỗi ngày (thông báo đẩy) — xem docs/nhac-ghi-chep.md ---
# Tạo cặp khoá bằng:  npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Địa chỉ liên hệ của bạn, dạng mailto:
VAPID_SUBJECT=mailto:ban@example.com
# Chuỗi ngẫu nhiên dài; PHẢI giống giá trị lưu trong Supabase Vault (supabase/reminders-cron.sql)
CRON_SECRET=
# Supabase → Project Settings → API Keys → secret key (service_role). CHỈ đặt ở máy chủ, không thêm NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
